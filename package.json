{
  "name": "dsh-project-autotest",
  "version": "1.0.0",
  "description": "DSH 插件：左侧栏「自动化测试流程」工作台 —— 按工作区切换项目，按自动化测试七步（需求→计划→用例→环境→脚本→结果→Bug）管理测试项目，用例可导出 XMind 思维导图 / TestLink XML / CSV / Markdown；数据按工作区持久化在 $DSH_HOME/storages 下。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test:host": "node test/host.test.mjs",
    "test:render": "node test/render.test.mjs",
    "test:dom": "node test/dom.test.mjs",
    "test": "npm run test:host && npm run test:render && npm run test:dom",
    "verify": "npm run build && npm run check && npm run test"
  },
  "license": "MIT",
  "icon": "icon.svg"
}
