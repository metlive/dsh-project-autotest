# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directories
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache
.stylelintcache

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.tmp

# ---------------------------------------------------------------------------
# Project choices overriding GitHub's template above.
#
# Build output IS committed on purpose: `dsh plugin add <path>` mounts the
# package as-is and never runs a build, so lib/index.js and lib/client.js must
# be present and current in the checkout (see README → 开发). The template's
# `lib-cov` rule is negated for exactly those two files, and nothing here may
# re-ignore them.
#
# Runtime data the workbench writes into the workspace it is tested against,
# including the requirement documents stage ① stores there.
docs/autotest/
!lib/
!lib/index.js
!lib/client.js
